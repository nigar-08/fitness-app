FROM maven:3.9.9-eclipse-temurin-21 AS build

ARG SERVICE_DIR
WORKDIR /workspace

COPY pom.xml ./
COPY eureka/pom.xml eureka/pom.xml
COPY configserver/pom.xml configserver/pom.xml
COPY userservice/pom.xml userservice/pom.xml
COPY activityservice/pom.xml activityservice/pom.xml
COPY aiservice/pom.xml aiservice/pom.xml
COPY gateway/pom.xml gateway/pom.xml
COPY ${SERVICE_DIR}/src ${SERVICE_DIR}/src

RUN mvn --batch-mode -pl ${SERVICE_DIR} -am -DskipTests package

FROM eclipse-temurin:21-jre-alpine

ARG SERVICE_DIR
WORKDIR /app
COPY --from=build /workspace/${SERVICE_DIR}/target/*.jar app.jar

EXPOSE 8080 8083 8091 8092 8761 8888
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
